@page
@model UnitransporteWeb.Pages.UsuariosModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Usuários";
}

<div class="relacao-wrapper">
    <div class="relacao-header-banner">
        <h2>USUÁRIOS</h2>
    </div>

    <div class="content-container-box" style="margin-bottom: 24px;">
        <form method="post" class="form-grid-5">
            <div class="field">
                <label for="nomeDaPessoa">Nome:</label>
                <input id="nomeDaPessoa" name="NomeDaPessoa" value="" />
            </div>
            <div class="field">
                <label for="nomeDeUsuario">Usuário:</label>
                <input id="nomeDeUsuario" name="NomeDeUsuario" value="" />
            </div>
            <div class="field">
                <label for="senha">Senha:</label>
                <input id="senha" name="Senha" type="password" value="" />
            </div>
            <div class="field">
                <label for="email">Email:</label>
                <input id="email" name="Email" type="email" value="" />
            </div>
            <div class="field">
                <label for="cargo">Cargo:</label>
                <select id="cargo" name="Cargo">
                    <option value="Motorista" selected="">Motorista</option>
                    <option value="Administrador" selected="">Administração</option>
                </select>
            </div>

            @if (!string.IsNullOrEmpty(Model.Erro))
            {
                <p class="field-error" style="grid-column: 1 / -1;">@Model.Erro</p>
            }

            <div style="grid-column: 1 / -1; display: flex; justify-content: center; margin-top: 10px;">
                <button class="btn btn-cadastrar-encomenda" type="submit" style="width: auto; padding: 0 32px;">Cadastrar / Alterar</button>
            </div>
        </form>
    </div>

    <div class="card card-table-wrapper dark-table-container">
        <div class="table-responsive">
            <table class="responsive-table custom-admin-table">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Usuário</th>
                        <th>Senha</th>
                        <th>Email</th>
                        <th>Cargo</th>
                        <th>Status</th>
                        <th class="text-right"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Store.Usuarios.Count == 0)
                    {
                        <tr>
                            <td>Hugo Quirol Lima</td>
                            <td class="mono">hugo123</td>
                            <td class="mono">123456</td>
                            <td>teste123@gmail.com</td>
                            <td>Administração</td>
                            <td>Ativo</td>
                            <td class="text-right">
                                <button type="button" class="btn btn-danger btn-sm">Desativar</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var u in Model.Store.Usuarios)
                        {
                            <tr>
                                <td data-label="Nome"><strong>@u.NomeDaPessoa</strong></td>
                                <td data-label="Usuário" class="mono">@u.NomeDeUsuario</td>
                                <td data-label="Senha" class="mono">••••••</td>
                                <td data-label="Email">@u.Email</td>
                                <td data-label="Cargo">Motorista</td>
                                <td data-label="Status">@(u.Ativo ? "Ativo" : "Desativado")</td>
                                <td data-label="Ações" class="text-right">
                                    <form method="post" asp-page-handler="Toggle" style="display:inline;">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button class="btn btn-danger btn-sm" type="submit">@(u.Ativo ? "Desativar" : "Reativar")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>