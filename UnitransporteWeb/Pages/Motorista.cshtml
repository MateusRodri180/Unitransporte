@page
@model UnitransporteWeb.Pages.MotoristaModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Minhas encomendas";
}

<div class="relacao-wrapper">
    <div class="relacao-header-banner mobile-hidden">
        <h2>Relação de entregas e coletas</h2>
    </div>

    <div class="stat-tabs-row">
        <a href="/Motorista?tab=pendentes" class="stat-tab-card @(Model.Tab == "pendentes" ? "active-tab" : "")" style="text-decoration:none;">
            <span class="tab-label">Pendentes</span>
            <span class="tab-badge">@Model.PendentesCount</span>
        </a>
        <a href="/Motorista?tab=coletados" class="stat-tab-card @(Model.Tab == "coletados" ? "active-tab" : "")" style="text-decoration:none;">
            <span class="tab-label">Coletados</span>
            <span class="tab-badge">@Model.ColetadosCount</span>
        </a>
        <a href="/Motorista?tab=concluidos" class="stat-tab-card @(Model.Tab == "concluidos" ? "active-tab" : "")" style="text-decoration:none;">
            <span class="tab-label">Concluídos</span>
            <span class="tab-badge">@Model.ConcluidosCount</span>
        </a>
    </div>

    <!-- Visualização Desktop (Tabela) -->
    <div class="card card-table-wrapper dark-table-container desktop-table-view">
        <div class="table-responsive">
            <table class="responsive-table custom-admin-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Coleta</th>
                        <th>Entrega</th>
                        <th>Dimensão</th>
                        <th>Peso</th>
                        <th>Valor</th>
                        <th>Tipo</th>
                        <th class="text-right"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MinhasEncomendas.Count == 0)
                    {
                        <tr>
                            <td>Cliente 1</td>
                            <td>Rua 1, 25, Bairro 1, Cidade 1</td>
                            <td>Rua 2, 45, Bairro 2, Cidade 1</td>
                            <td>40×20×50</td>
                            <td>50Kg</td>
                            <td class="mono">R$50,55</td>
                            <td>Coleta e Entrega</td>
                            <td class="text-right">
                                <button type="button" class="btn btn-sm" style="background: var(--orange); color: var(--primary-gray); font-weight: 700; border-radius: 8px; padding: 6px 16px;">Coletado</button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var e in Model.MinhasEncomendas)
                        {
                            <tr>
                                <td><strong>@e.ClienteNome</strong></td>
                                <td>@e.PontoDeColeta</td>
                                <td>@e.PontoDeDestino</td>
                                <td>@e.Dimensoes</td>
                                <td>@e.Peso Kg</td>
                                <td class="mono">R$ @e.ValorDoFrete.ToString("0.00")</td>
                                <td>Coleta e Entrega</td>
                                <td class="text-right">
                                    <button type="button" class="btn btn-sm" style="background: var(--orange); color: var(--primary-gray); font-weight: 700; border-radius: 8px; padding: 6px 16px;">Coletado</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Visualização Mobile (Cartões em Pílula Laranja) -->
    <div class="motorista-mobile-cards">
        <div class="motorista-pill-card">Entrega 1: Nome do Cliente</div>
        <div class="motorista-pill-card">Entrega 2: Nome do Cliente</div>
        <div class="motorista-pill-card">Entrega 3: Nome do Cliente</div>
        <div class="motorista-pill-card">Entrega 4: Nome do Cliente</div>
    </div>
</div>