@page
@model UnitransporteWeb.Pages.EntregasModel
@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Entregas e coletas";
}

<div class="relacao-wrapper">
    <div class="relacao-header-banner">
        <h2>Relação de entregas e coletas</h2>
    </div>

    <div class="stat-tabs-row">
        <div class="stat-tab-card active-tab">
            <span class="tab-label">Pendentes</span>
            <span class="tab-badge">@Model.PendentesCount</span>
        </div>
        <div class="stat-tab-card">
            <span class="tab-label">Coletados</span>
            <span class="tab-badge">@Model.ColetadosCount</span>
        </div>
        <div class="stat-tab-card">
            <span class="tab-label">Concluídos</span>
            <span class="tab-badge">@Model.ConcluidosCount</span>
        </div>
    </div>

    <div class="card card-table-wrapper dark-table-container">
        <div class="table-responsive">
            <table class="responsive-table custom-admin-table">
                <thead>
                    <tr>
                        <th class="checkbox-col"><input type="checkbox" /></th>
                        <th>Cliente</th>
                        <th>Motorista</th>
                        <th>Endereço</th>
                        <th>Tipo</th>
                        <th class="text-right"><span class="header-cancel-btn">Cancelar</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Pendentes.Count == 0)
                    {
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td>Cliente 1</td>
                            <td>Motorista 1</td>
                            <td>Rua 1, 25, Bairro 1, Cidade 1</td>
                            <td>Coleta e Entrega</td>
                            <td class="text-right mono">R$ 50,55</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var e in Model.Pendentes)
                        {
                            <tr>
                                <td><input type="checkbox" /></td>
                                <td data-label="Cliente">
                                    <strong>@e.ClienteNome</strong>
                                </td>
                                <td data-label="Motorista">
                                    @Model.NomeMotorista(e.MotoristaId)
                                </td>
                                <td data-label="Endereço">
                                    @e.PontoDeColeta
                                </td>
                                <td data-label="Tipo">
                                    Coleta e Entrega
                                </td>
                                <td data-label="Ações" class="text-right actions-cell">
                                    @if (Model.CancelandoId == e.Id)
                                    {
                                        <form method="post" asp-page-handler="Cancelar" class="cancel-inline">
                                            <input type="hidden" name="CancelarId" value="@e.Id" />
                                            <input class="cancel-inline-input" name="Motivo" placeholder="Motivo" required />
                                            <button class="btn btn-danger btn-sm" type="submit">OK</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="mono">R$ @e.ValorDoFrete.ToString("0.00")</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>