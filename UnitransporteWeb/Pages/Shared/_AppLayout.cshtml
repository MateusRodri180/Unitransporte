@{
    Layout = "_Layout";
    var usuario = ViewData["CurrentUser"] as UnitransporteWeb.Models.Usuario;
    var ativo = ViewData["ActivePage"] as string ?? "";
    var isAdmin = usuario?.Cargo == UnitransporteWeb.Models.Cargo.Administrador;
}
<div class="app-shell">
    <aside class="app-sidebar">
        <div class="app-brand">
            <div class="branch-tag">UNITRANS</div>
        </div>
        <nav class="app-nav">
            @if (isAdmin)
            {
                <a class="app-nav-link @(ativo == "entregas" ? "is-active" : "")" href="/Entregas">Entregas e coletas</a>
                <a class="app-nav-link @(ativo == "nova" ? "is-active" : "")" href="/EncomendaNova">Nova encomenda</a>
                <a class="app-nav-link @(ativo == "historico" ? "is-active" : "")" href="/Historico">Histórico</a>
                <a class="app-nav-link @(ativo == "usuarios" ? "is-active" : "")" href="/Usuarios">Usuários</a>
                <a class="app-nav-link @(ativo == "veiculos" ? "is-active" : "")" href="/Veiculos">Veículos</a>
            }
            else
            {
                <a class="app-nav-link @(ativo == "motorista" ? "is-active" : "")" href="/Motorista">Minhas encomendas</a>
            }
        </nav>
    </aside>
    <div class="app-main">
        <header class="app-topbar">
            @* <div class="app-topbar-user">
                <span class="app-topbar-name">@usuario?.NomeDaPessoa</span>
                <span class="app-role-badge @(isAdmin ? "is-admin" : "is-motorista")">@usuario?.Cargo</span>
            </div> *@
            <div class="user-avatar-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                </svg>
            </div>
        </header>
        <main class="app-content">
            <div class="content-container-box">
                @RenderBody()
            </div>
        </main>
    </div>
</div>
@await RenderSectionAsync("Scripts", required: false)